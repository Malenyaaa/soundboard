<Window x:Class="Soundboard.App.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:Soundboard.App.Text"
        Title="{t:T Uninstall.Title}" Icon="/Assets/Soundboard.ico"
        Width="760" Height="780" MinWidth="480" MinHeight="400" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontText}" FontSize="{DynamicResource SizeText}">
    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style x:Key="B" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NoticeBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NoticeLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0" Padding="16,8">
            <Button Content="{t:T Common.Close}" Padding="16,5" HorizontalAlignment="Right" Click="OnClose" IsCancel="True" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,8,20,20" MaxWidth="700" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource P}" Margin="0,10,0,0"
                           Text="{t:T Uninstall.Intro}" />

                <Border x:Name="RunningBox" Style="{StaticResource Notice}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P}" Foreground="{DynamicResource NoticeText}"
                                   Text="{t:T Uninstall.Running}" />
                    </StackPanel>
                </Border>

                <!-- 1 -->
                <TextBlock Style="{StaticResource H}" Text="{t:T Uninstall.H1}" />
                <TextBlock x:Name="StateText" Style="{StaticResource P}" />
                <Button x:Name="RestoreButton" Style="{StaticResource B}" Content="{t:T Action.Restore}" Click="OnRestore"
                        ToolTip="{t:T Restore.Tip}" />
                <TextBlock x:Name="RestoreText" Style="{StaticResource P}" Margin="0,6,0,0" Visibility="Collapsed" />

                <!-- 2 -->
                <TextBlock Style="{StaticResource H}" Text="{t:T Uninstall.H2}" />
                <TextBlock x:Name="TracesText" Style="{StaticResource P}" />
                <CheckBox x:Name="KeepSounds" Content="{t:T Uninstall.KeepSounds}" IsChecked="True" Margin="0,8,0,0" Checked="OnKeepChanged" Unchecked="OnKeepChanged" />
                <Button x:Name="RemoveButton" Style="{StaticResource B}" Content="{t:T Uninstall.RemoveData}" Click="OnRemoveTraces" />
                <TextBlock x:Name="RemoveText" Style="{StaticResource P}" Margin="0,6,0,0" Visibility="Collapsed" />

                <!-- 3 -->
                <TextBlock Style="{StaticResource H}" Text="{t:T Uninstall.H3}" />
                <TextBlock Style="{StaticResource P}"
                           Text="{t:T Uninstall.CableIntro}" />
                <TextBlock Style="{StaticResource P}" Margin="0,6,0,0">
                    <Run Text="{t:T Uninstall.U1}" /><LineBreak />
                    <Run Text="{t:T Uninstall.U2}" /><LineBreak />
                    <Run Text="{t:T Uninstall.U3}" /><LineBreak />
                    <Run Text="{t:T Uninstall.U4}" /><LineBreak />
                    <Run Text="{t:T Uninstall.U5}" />
                </TextBlock>
                <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" Foreground="{DynamicResource SubTextBrush}"
                           Text="{t:T Uninstall.Advanced}" />
                <Button Style="{StaticResource B}" Content="{t:T Uninstall.DeviceManager}" Click="OnDeviceManager" />

                <!-- 4 -->
                <TextBlock Style="{StaticResource H}" Text="{t:T Uninstall.H4}" />
                <TextBlock x:Name="DiscordText" Style="{StaticResource P}" />
                <TextBlock Style="{StaticResource P}" Margin="0,10,0,0"
                           Text="{t:T Uninstall.CompareHint}" />
                <Button Style="{StaticResource B}" Content="{t:T State.CompareAgain}" Click="OnCompare" />
                <DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" MaxHeight="320"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                         >
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{t:T Grid.What}" Binding="{Binding What}" Width="2*" />
                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{t:T Grid.Saved}" Binding="{Binding Saved}" Width="2*" />
                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{t:T Grid.Now}" Binding="{Binding Now}" Width="2*" />
                        <DataGridTemplateColumn Header="{t:T Grid.Result}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="K" Text="{Binding KindText}" FontWeight="SemiBold" Foreground="{DynamicResource DiffText}" Margin="4,0" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Same">
                                            <Setter TargetName="K" Property="Foreground" Value="{DynamicResource OkText}" />
                                            <Setter TargetName="K" Property="FontWeight" Value="Normal" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="CompareText" Style="{StaticResource P}" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
