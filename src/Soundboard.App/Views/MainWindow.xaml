<Window x:Class="Soundboard.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Soundboard"
        Width="1000" Height="700" MinWidth="560" MinHeight="420"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown"
        Closed="OnClosed">

    <Window.Resources>
        <!-- Clickable area of a tile: hover and pressed are visible, focus gets a frame. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="6,6,0,0" Padding="10,8,10,6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlay}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OnStopBrush}" />
            <Setter Property="Background" Value="{DynamicResource StopBg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StopHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StopPressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StopFocus}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Step tab of the setup panel: Tag = true marks the current step (underline + bold). -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0"
                                    BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter x:Name="Cp" />
                            </Border>
                            <Border x:Name="Line" Height="3" VerticalAlignment="Bottom" Background="{DynamicResource SignalBrush}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlay}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedOverlay}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PlainButton">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status line -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Sound-Ordner öffnen" Style="{StaticResource PlainButton}" Margin="8,0,0,0"
                        Command="{Binding OpenSoundsFolderCommand}" ToolTip="{Binding SoundsDir}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding StatusMonitor, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding StatusHotkeys, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding StatusMix, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding StatusCable, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding StatusDefaults}" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Device list (read only) -->
        <Expander DockPanel.Dock="Bottom" Margin="12,4,12,6" Header="{Binding DevicesHeader}"
                  Visibility="{Binding SetupOpen, Converter={StaticResource NotBoolToVis}}">
            <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Neu einlesen" Style="{StaticResource PlainButton}" Command="{Binding RefreshDevicesCommand}" />
                    <CheckBox VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding ShowNotPresent}"
                              Content="{Binding NotPresentCount}" ContentStringFormat="Auch nicht mehr vorhandene Geräte zeigen ({0})"
                              ToolTip="Windows merkt sich früher benutzte Geräte. Sie sind ausgeblendet, damit die Liste übersichtlich bleibt." />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                               Text="Die Liste aktualisiert sich auch von selbst, wenn ein Gerät dazukommt oder wegfällt." />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="230"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                          SelectionUnit="FullRow" HorizontalGridLinesBrush="{DynamicResource GridLine}" Background="{DynamicResource SurfaceBg}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Richtung" Binding="{Binding Richtung}" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Windows-Standard für" Binding="{Binding Standard}" />
                        <DataGridTextColumn Header="Lautstärke" Binding="{Binding Lautstaerke}" />
                        <DataGridTextColumn Header="Mix-Format" Binding="{Binding Format}" />
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Expander>

        <!-- Saved Windows audio state vs. now -->
        <Expander DockPanel.Dock="Bottom" Margin="12,4,12,0" Header="{Binding SnapshotHeader}"
                  Visibility="{Binding SetupOpen, Converter={StaticResource NotBoolToVis}}">
            <DockPanel Margin="0,6,0,0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button Content="Wie vorher" Style="{StaticResource PlainButton}" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,8,4"
                            ToolTip="Stellt die Windows-Standardgeräte auf die gesicherten zurück. Sonst wird nichts verändert." />
                    <Button Content="Audio-Zustand jetzt sichern" Style="{StaticResource PlainButton}" Command="{Binding SaveSnapshotNowCommand}" Margin="0,0,8,4"
                            ToolTip="Merkt sich, wie Windows-Audio gerade eingestellt ist. Spätere Änderungen werden damit verglichen." />
                    <Button Content="Neu vergleichen" Style="{StaticResource PlainButton}" Command="{Binding CompareAgainCommand}" Margin="0,0,16,4" />
                    <TextBlock Text="{Binding SnapshotInfo}" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding RestoreResultText}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding RestoreResultText, Converter={StaticResource TextToVis}}" />
                <DataGrid ItemsSource="{Binding ComparisonRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                          HorizontalGridLinesBrush="{DynamicResource GridLine}" Background="{DynamicResource SurfaceBg}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Was" Binding="{Binding What}" Width="2*" />
                        <DataGridTextColumn Header="Gesichert" Binding="{Binding Saved}" Width="2*" />
                        <DataGridTextColumn Header="Jetzt" Binding="{Binding Now}" Width="2*" />
                        <DataGridTemplateColumn Header="Ergebnis" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="K" Text="{Binding KindText}" FontWeight="SemiBold" Foreground="{DynamicResource DiffText}" Margin="4,0" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding KindText}" Value="gleich">
                                            <Setter TargetName="K" Property="Foreground" Value="{DynamicResource OkText}" />
                                            <Setter TargetName="K" Property="FontWeight" Value="Normal" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Expander>

        <!-- Header: playback controls -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Einrichtung" Style="{StaticResource PlainButton}" Margin="0,0,12,0" VerticalAlignment="Center"
                        Command="{Binding OpenSetupCommand}" ToolTip="Kabel, Discord und Rauschunterdrückung einrichten – Schritt für Schritt." />
                <Button DockPanel.Dock="Right" Style="{StaticResource StopButton}" Content="■  Alles stoppen"
                        Command="{Binding StopAllCommand}" ToolTip="{Binding StopAllToolTip}" VerticalAlignment="Center" />
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,4,20,4">
                        <CheckBox Content="Mithören auf" IsChecked="{Binding MonitorEnabled}" VerticalAlignment="Center"
                                  ToolTip="Spielt die Sounds auf diesem Gerät ab, damit du sie selbst hörst." />
                        <ComboBox ItemsSource="{Binding OutputChoices}" SelectedItem="{Binding SelectedOutput}"
                                  DisplayMemberPath="Display" Width="280" Margin="8,0,0,0"
                                  ToolTip="Gerät für das Mithören. Die Windows-Einstellungen bleiben unverändert." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,20,4">
                        <TextBlock Text="Lautstärke Sounds" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="100" Width="140" Margin="8,0" VerticalAlignment="Center"
                                Value="{Binding MasterVolumePercent}" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                ToolTip="Gesamtlautstärke aller Sounds in diesem Programm (nicht die Windows-Lautstärke)." />
                        <TextBlock Text="{Binding MasterVolumePercent, StringFormat={}{0:0} %}" Width="40" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="Hotkeys pausieren" IsChecked="{Binding HotkeysPaused}" VerticalAlignment="Center" Margin="0,4,20,4"
                              ToolTip="Gibt alle Tasten frei, z. B. wenn du im Spiel chattest. Nochmal klicken: Tasten wieder aktiv." />
                    <CheckBox Content="Sounds überlagern" IsChecked="{Binding OverlayEnabled}" VerticalAlignment="Center" Margin="0,4,20,4"
                              ToolTip="Aus: ein neuer Sound stoppt den laufenden. An: mehrere Sounds spielen gleichzeitig." />
                    <Button Content="Sounds hinzufügen …" Style="{StaticResource PlainButton}" Command="{Binding AddFilesDialogCommand}"
                            Margin="0,4,20,4" ToolTip="MP3-, WAV-, OGG- oder FLAC-Dateien auswählen. Sie werden in den Sound-Ordner kopiert." />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Microphone path: microphone + sounds go into the mix (test file now, cable later) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,6,12,8"
                Visibility="{Binding SetupOpen, Converter={StaticResource NotBoolToVis}}">
            <WrapPanel VerticalAlignment="Center">
                <CheckBox Content="Ans Kabel senden" IsChecked="{Binding CableEnabled}" VerticalAlignment="Center" Margin="0,4,20,4"
                          ToolTip="Mikrofon und Sounds gehen ins virtuelle Kabel. In Discord wählst du „CABLE Output“ als Mikrofon." />
                <StackPanel Orientation="Horizontal" Margin="0,4,20,4">
                    <TextBlock Text="Mikrofon" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding MicChoices}" SelectedItem="{Binding SelectedMic}" DisplayMemberPath="Display"
                              Width="300" Margin="8,0,0,0"
                              ToolTip="Dein echtes Mikrofon. Es wird mit den Sounds gemischt. Die Windows-Einstellungen bleiben unverändert." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,20,4">
                    <TextBlock Text="Mikro-Lautstärke" VerticalAlignment="Center" />
                    <Slider Minimum="0" Maximum="200" Width="110" Margin="8,0" VerticalAlignment="Center"
                            Value="{Binding MicVolumePercent}" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                            ToolTip="Lautstärke deiner Stimme im Mix. 100 % = unverändert. Die Windows-Lautstärke des Mikrofons bleibt, wie sie ist." />
                    <TextBlock Text="{Binding MicVolumePercent, StringFormat={}{0:0} %}" Width="44" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,20,4" ToolTip="Das sendet dein Kabel gerade: Stimme und Sounds.">
                    <TextBlock Text="Pegel" VerticalAlignment="Center" />
                    <ProgressBar Width="110" Height="8" Margin="8,0,0,0" Minimum="0" Maximum="1" Value="{Binding MixLevel, Mode=OneWay}"
                                 Foreground="{DynamicResource MeterBrush}" Background="{DynamicResource TrackBg}" BorderThickness="0" VerticalAlignment="Center" />
                    <Button Content="Testton" Style="{StaticResource PlainButton}" Margin="8,0,0,0" Command="{Binding PlayTestToneCommand}"
                            ToolTip="Schickt eine Sekunde lang einen Ton ins Kabel (nicht auf deinen Kopfhörer)." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,20,4">
                    <TextBlock Text="Puffer" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding BufferChoices}" SelectedItem="{Binding SelectedBuffer}" DisplayMemberPath="Display"
                              Width="140" Margin="8,0,0,0"
                              ToolTip="Klein = weniger Verzögerung. Größer wählen, wenn die Stimme knackt oder Aussetzer hat." />
                </StackPanel>
                <CheckBox Content="Stimme blockieren" IsChecked="{Binding BlockVoice}" VerticalAlignment="Center" Margin="0,4,20,4"
                          ToolTip="Dein Mikrofon ist stumm, solange ein Sound läuft." />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <Button Content="10 s Test aufnehmen" Style="{StaticResource PlainButton}" Command="{Binding RecordTestCommand}"
                            ToolTip="Nimmt 10 Sekunden Mikrofon und Sounds in eine WAV-Datei auf. So hörst du ohne Kabel, wie der Mix klingt." />
                    <TextBlock Text="{Binding TestStatus}" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" MaxWidth="360" />
                    <Button Content="Im Ordner zeigen" Style="{StaticResource PlainButton}" Margin="8,0,0,0" Command="{Binding ShowTestFileCommand}"
                            Visibility="{Binding HasTestFile, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Yellow notices -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Notices}" Margin="12,0,12,0"
                      Visibility="{Binding SetupOpen, Converter={StaticResource NotBoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource NoticeBg}" BorderBrush="{DynamicResource NoticeLine}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Schließen" Style="{StaticResource PlainButton}" Margin="8,0,0,0"
                                    Command="{Binding CloseCommand}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Style="{StaticResource PlainButton}" Margin="8,0,0,0"
                                    Command="{Binding RunActionCommand}" VerticalAlignment="Center"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}" />
                            <TextBlock DockPanel.Dock="Left" Text="⚠" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource NoticeText}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource NoticeText}" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Tiles -->
        <Grid Background="Transparent">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tiles}" Margin="8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tile" Width="176" Margin="6" CornerRadius="6" Background="{Binding Background}"
                                    BorderBrush="{DynamicResource TileLine}" BorderThickness="1" ToolTip="{Binding ToolTipText}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Taste belegen …" Command="{Binding AssignHotkeyCommand}" />
                                        <MenuItem Header="Taste entfernen" Command="{Binding ClearHotkeyCommand}"
                                                  Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVis}}" />
                                        <Separator />
                                        <MenuItem Header="Umbenennen" Command="{Binding RenameCommand}" />
                                        <MenuItem Header="Im Sound-Ordner zeigen" Command="{Binding ShowInFolderCommand}" />
                                        <Separator />
                                        <MenuItem Header="Entfernen" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=Explicit}" Margin="8,8,8,0" Padding="2"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                             KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus"
                                             IsVisibleChanged="OnRenameVisibleChanged" />
                                    <Grid>
                                        <Button Style="{StaticResource TileButton}" Command="{Binding ClickCommand}" Height="88">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Bottom">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PlayGlyph}" FontSize="14" Foreground="{DynamicResource TileText}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding HotkeyLabel}" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TileText}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TileSubText}" FontSize="12" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TileText}"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Button>
                                        <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource SignalBrush}" BorderThickness="2"
                                                CornerRadius="6,6,0,0" Padding="10,6"
                                                Visibility="{Binding IsCapturingKey, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding CaptureHint}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextBrush}" FontSize="11.5" LineHeight="15" />
                                        </Border>
                                    </Grid>
                                    <ProgressBar Height="5" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                 Foreground="{DynamicResource SignalBrush}" Background="{DynamicResource TrackBg}" BorderThickness="0" />
                                    <DockPanel Margin="8,4,8,6">
                                        <TextBlock DockPanel.Dock="Left" Text="Lautst." VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TileSubText}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding VolumePercent, StringFormat={}{0:0} %}" Width="36"
                                                   TextAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TileSubText}" />
                                        <Slider Minimum="0" Maximum="100" Value="{Binding VolumePercent}" Margin="4,0" VerticalAlignment="Center"
                                                SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                                ToolTip="Lautstärke dieses Sounds" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
                                    <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource NoticeLine}" />
                                    <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="24" FontSize="15" Foreground="{DynamicResource SubTextBrush}" IsHitTestVisible="False"
                       Visibility="{Binding HasNoTiles, Converter={StaticResource BoolToVis}}">
                <Run Text="Noch keine Sounds." FontWeight="SemiBold" />
                <LineBreak />
                <Run Text="Zieh MP3-, WAV-, OGG- oder FLAC-Dateien in dieses Fenster" />
                <LineBreak />
                <Run Text="oder nutze oben „Sounds hinzufügen …“." />
            </TextBlock>

            <!-- Setup panel: covers the tiles while open -->
            <Border Background="{DynamicResource WindowBg}" Visibility="{Binding SetupOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10,16,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Einrichtung schließen" Style="{StaticResource PlainButton}" Margin="0"
                                    Command="{Binding CloseSetupCommand}" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Einrichtung" FontSize="20" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource StepButton}" Command="{Binding GoToStepCommand}" CommandParameter="1"
                                            Tag="{Binding IsSetupStep1}" Content="1  Kabel" />
                                    <Button Style="{StaticResource StepButton}" Command="{Binding GoToStepCommand}" CommandParameter="2"
                                            Tag="{Binding IsSetupStep2}" Content="2  Discord" />
                                    <Button Style="{StaticResource StepButton}" Command="{Binding GoToStepCommand}" CommandParameter="3"
                                            Tag="{Binding IsSetupStep3}" Content="3  Rauschunterdrückung" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,12,16,16" MaxWidth="760" HorizontalAlignment="Left">

                            <!-- Step 1: cable -->
                            <StackPanel Visibility="{Binding IsSetupStep1, Converter={StaticResource BoolToVis}}">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Das Soundboard mischt dein Mikrofon und die Sounds und schickt beides in ein virtuelles Audiokabel. Discord nimmt das Kabel als Mikrofon. Die Windows-Standardgeräte bleiben, wie sie sind." />

                                <!-- Cable missing -->
                                <Border Background="{DynamicResource NoticeBg}" BorderBrush="{DynamicResource NoticeLine}" BorderThickness="1" CornerRadius="4" Padding="12,10"
                                        Visibility="{Binding CableFound, Converter={StaticResource NotBoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CableStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource NoticeText}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource NoticeText}">
                                            <Run Text="Gebraucht wird VB-CABLE von VB-Audio, zu finden auf" />
                                            <Hyperlink Command="{Binding OpenCableWebsiteCommand}" Foreground="{DynamicResource NoticeText}">vb-cable.com</Hyperlink><Run Text=". VB-CABLE ist Donationware: kostenlos nutzbar, Spenden an VB-Audio sind willkommen („VB-CABLE is a donationware, all participations are welcome.“). Das Soundboard liefert es nicht mit." />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource NoticeText}" LineHeight="20">
                                            <Run Text="1. Zuerst „Audio-Zustand jetzt sichern“ klicken. So zeigt das Soundboard später, ob das Setup etwas verstellt hat." /><LineBreak />
                                            <Run Text="2. Auf vb-cable.com das ZIP-Paket für Windows laden und entpacken." /><LineBreak />
                                            <Run Text="3. VBCABLE_Setup_x64.exe mit Rechtsklick → „Als Administrator ausführen“ starten, dann „Install Driver“." /><LineBreak />
                                            <Run Text="4. Windows neu starten und das Soundboard wieder öffnen. Es findet das Kabel und vergleicht mit der Sicherung." />
                                        </TextBlock>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Audio-Zustand jetzt sichern" Style="{StaticResource PlainButton}" Command="{Binding SaveSnapshotNowCommand}" Margin="0,0,8,4" />
                                            <Button Content="vb-cable.com öffnen" Style="{StaticResource PlainButton}" Command="{Binding OpenCableWebsiteCommand}" Margin="0,0,8,4" />
                                            <Button Content="Nach dem Kabel suchen" Style="{StaticResource PlainButton}" Command="{Binding SearchCableCommand}" Margin="0,0,8,4" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SnapshotHeader}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource NoticeText}" />
                                        <TextBlock Text="{Binding RestoreResultText}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource NoticeText}"
                                                   Visibility="{Binding RestoreResultText, Converter={StaticResource TextToVis}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Cable found -->
                                <StackPanel Visibility="{Binding CableFound, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CableStatusText}" TextWrapping="Wrap" />
                                    <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceBg}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Wie vorher" Style="{StaticResource PlainButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding RestoreDefaultsCommand}"
                                                    Visibility="{Binding CableCompareProblem, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding CableCompareText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="{Binding RestoreResultText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding RestoreResultText, Converter={StaticResource TextToVis}}" />
                                    <CheckBox Content="Mikrofon und Sounds ans Kabel senden" IsChecked="{Binding CableEnabled}" Margin="0,12,0,0" />
                                    <TextBlock Text="Das sendet dein Kabel gerade" FontWeight="SemiBold" Margin="0,14,0,4" />
                                    <StackPanel Orientation="Horizontal">
                                        <ProgressBar Width="280" Height="12" Minimum="0" Maximum="1" Value="{Binding MixLevel, Mode=OneWay}"
                                                     Foreground="{DynamicResource MeterBrush}" Background="{DynamicResource TrackBg}" BorderThickness="0" VerticalAlignment="Center" />
                                        <Button Content="Testton senden" Style="{StaticResource PlainButton}" Margin="12,0,0,0" Command="{Binding PlayTestToneCommand}"
                                                ToolTip="Schickt eine Sekunde lang einen Ton ins Kabel. Auf deinem Kopfhörer ist er nicht zu hören." />
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource SubTextBrush}"
                                               Text="Sprich: Der Balken schlägt aus. Gegenprobe ohne Discord: Windows-Systemsteuerung → Sound → Registerkarte „Aufnahme“ – bei „CABLE Output“ bewegt sich die Anzeige." />
                                </StackPanel>

                                <Button Content="Weiter zu Schritt 2" Style="{StaticResource PlainButton}" Command="{Binding GoToStepCommand}" CommandParameter="2"
                                        HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
<!--STEP23-->
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
