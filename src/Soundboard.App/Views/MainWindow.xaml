<Window x:Class="Soundboard.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Soundboard.App.Views"
        xmlns:t="clr-namespace:Soundboard.App.Text"
        Title="Soundboard" Icon="/Assets/Soundboard.ico"
        Width="1000" Height="700" MinWidth="560" MinHeight="420"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontText}" FontSize="{DynamicResource SizeText}"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown"
        PreviewMouseMove="OnWindowMouseMove" PreviewMouseLeftButtonUp="OnWindowMouseUp"
        SizeChanged="OnSizeChanged" Closed="OnClosed">

    <!--
        Leitsatz: a pad sampler on the desk. The housing (bars, settings) stays quiet grey;
        the pads carry the colour and light up while they play.
    -->
    <Window.Resources>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SizeGroup}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock" BasedOn="{StaticResource P}">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Table cells that read badly when broken (states, levels, formats): one line. -->
        <Style x:Key="CellOneLine" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontDisplay}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The pad itself: a key with a thick lower edge in a darker shade of its colour, like the
             key caps; pressed, the face sinks onto the edge. Lit state comes from the data template. -->
        <Style x:Key="PadButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EdgeBd" Background="{Binding Pad.Edge}" CornerRadius="10" Padding="0,0,0,3.5" SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5" CornerRadius="10" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="12,10,12,10" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2.5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="EdgeBd" Property="Padding" Value="0,0,0,1" />
                                <Setter TargetName="EdgeBd" Property="Margin" Value="0,2.5,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The key printed on a pad as a key cap (thicker lower edge). -->
        <Style x:Key="KeyCap" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontPad}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,2,7,1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- transparent rim: the clickable area is 28 px high, the printed cap smaller -->
                        <Border Background="Transparent" Padding="0,2">
                            <Grid>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1,1,1,3" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="Hover" CornerRadius="5" Background="{DynamicResource HoverOverlay}" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1,2,1,2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A key printed as a key cap in lists (not clickable; the row has the button). -->
        <Style x:Key="CapLook" TargetType="Border">
            <Setter Property="BorderThickness" Value="1,1,1,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2,7,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Background" Value="{DynamicResource RaisedBg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- One row of the key list: function keys and pads alike. -->
        <DataTemplate x:Key="KeyRowTemplate">
            <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="12,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="K" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="B" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <!-- Only what differs from "works" is said (no key, paused, a problem). -->
                            <DockPanel Margin="0,2,0,0" Visibility="{Binding HotkeyStateText, Converter={StaticResource TextToVis}}">
                                <Path x:Name="W" Style="{StaticResource WarnIcon}" Margin="0,0,6,0" Visibility="Collapsed" />
                                <TextBlock x:Name="S" Text="{Binding HotkeyStateText}" Foreground="{DynamicResource SubTextBrush}" FontSize="13" TextWrapping="Wrap" />
                            </DockPanel>
                            <!-- The way out, unless it is "Choose another key" – that is the button on the right already. -->
                            <Button x:Name="Fix" Content="{Binding KeyIssueActionText}" Command="{Binding RunKeyIssueActionCommand}" FontSize="13" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Visibility="Collapsed" />
                        </StackPanel>
                        <Border x:Name="KeyCap" Grid.Column="1" Style="{StaticResource CapLook}" Margin="0,0,16,0">
                            <TextBlock Text="{Binding HotkeyText}" FontFamily="{DynamicResource FontPad}" FontSize="13" />
                        </Border>
                        <TextBlock x:Name="NoKey" Grid.Column="1" Text="–" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed" />
                        <Button x:Name="Change" Grid.Column="2" Content="{t:T Keys.Change}" Command="{Binding AssignHotkeyCommand}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Grid>
                    <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                            Visibility="{Binding IsCapturingKey, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CaptureHint}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasHotkey}" Value="False">
                    <Setter TargetName="Change" Property="Content" Value="{t:T Pad.AssignKey}" />
                    <Setter TargetName="KeyCap" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NoKey" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HotkeyProblem}" Value="True">
                    <Setter TargetName="W" Property="Visibility" Value="Visible" />
                    <Setter TargetName="S" Property="Foreground" Value="{DynamicResource DiffText}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HotkeyProblem}" Value="True" />
                        <Condition Binding="{Binding KeyIssueIsOtherKey}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Fix" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Colour chip in the design tab: selected = ring + tick. -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Width="76" Background="Transparent">
                            <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" />
                                <Border x:Name="Chip" Margin="5" CornerRadius="8" Background="{Binding Swatch}" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" />
                            </Grid>
                            <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource SubTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One pad. -->
        <DataTemplate x:Key="PadTemplate">
            <Grid x:Name="Root" Background="Transparent" ToolTip="{Binding ToolTipText}" MouseWheel="OnPadWheel" ToolTipService.InitialShowDelay="800"
                  PreviewMouseLeftButtonDown="OnPadMouseDown">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{t:T Pad.AssignKey}" Command="{Binding AssignHotkeyCommand}" />
                        <MenuItem Header="{t:T Pad.RemoveKey}" Command="{Binding ClearHotkeyCommand}"
                                  Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="{Binding KeyIssueActionText}" Command="{Binding RunKeyIssueActionCommand}"
                                  Visibility="{Binding HotkeyProblem, Converter={StaticResource BoolToVis}}" />
                        <Separator />
                        <MenuItem StaysOpenOnClick="True" Cursor="Arrow">
                            <MenuItem.Header>
                                <DockPanel Width="210">
                                    <TextBlock DockPanel.Dock="Left" Text="{t:T Pad.Volume}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeText}" Width="40" TextAlignment="Right" Style="{StaticResource Num}" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding VolumePercent}" SmallChange="1" LargeChange="10" Margin="0,0,6,0"
                                            AutomationProperties.Name="{t:T Pad.Volume}" ToolTip="{t:T Pad.VolumeTip}" />
                                </DockPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Header="{t:T Pad.EvenOut}" Command="{Binding EvenOutCommand}" ToolTip="{t:T Pad.EvenOutTip}" />
                        <MenuItem Header="{t:T Pad.EvenOutAll}" Command="{Binding EvenOutAllCommand}" ToolTip="{t:T Pad.EvenOutAllTip}" />
                        <Separator />
                        <MenuItem Header="{t:T Pad.Rename}" Command="{Binding RenameCommand}" InputGestureText="F2" />
                        <!-- Colour: automatic (by order) or one of the seven pad colours, each with its swatch. -->
                        <MenuItem Header="{t:T Pad.Colour}" ItemsSource="{Binding ColorMenu}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Command" Value="{Binding Command}" />
                                    <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0" Background="{Binding Swatch}" BorderThickness="1"
                                                BorderBrush="{DynamicResource LineBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding Swatch, Converter={StaticResource NullToCollapsed}}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>
                        <!-- Picture: choose, remove, open the folder – together under one entry. -->
                        <MenuItem Header="{t:T Pad.Picture}">
                            <MenuItem Header="{t:T Pad.ChoosePicture}" Command="{Binding ChooseImageCommand}"
                                      ToolTip="{t:T Pad.ChoosePictureTip}" />
                            <MenuItem Header="{t:T Pad.RemovePicture}" Command="{Binding RemoveImageCommand}"
                                      Visibility="{Binding HasImageConfigured, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{t:T Pad.OpenPictureFolder}" Command="{Binding OpenImagesFolderCommand}"
                                      ToolTip="{t:T Pad.OpenPictureFolderTip}" />
                        </MenuItem>
                        <MenuItem Header="{t:T Pad.ShowInFolder}" Command="{Binding ShowInFolderCommand}" />
                        <Separator />
                        <MenuItem Header="{t:T Pad.Remove}" Command="{Binding RemoveCommand}" InputGestureText="{t:T Key.DelShort}" />
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- Light around the pad while it plays (the LED shines through). -->
                <Border x:Name="Glow" CornerRadius="10" Background="{Binding Pad.Lit}" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="{Binding Pad.GlowColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.9" />
                    </Border.Effect>
                </Border>

                <Button x:Name="PadBtn" Style="{StaticResource PadButton}" Command="{Binding ClickCommand}"
                        Background="{Binding Pad.Face}" BorderBrush="{Binding Pad.Line}" Foreground="{Binding Pad.Text}"
                        AutomationProperties.Name="{Binding Name}" AutomationProperties.ItemStatus="{Binding PlayingStatus}"
                        AutomationProperties.HelpText="{Binding ToolTipText}">
                    <!-- Everything inside the rim, cut to the pad's rounded shape. -->
                    <Grid Margin="-12,-10" views:RoundClip.Radius="8.5">
                        <!-- Picture: fills the pad, centred and cut (uniform to fill); a little dimmed while the pad rests. -->
                        <Grid x:Name="Art" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
                            <Border>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                </Border.Background>
                            </Border>
                            <Border x:Name="Dim" Background="{DynamicResource PadImageDim}" />
                        </Grid>
                        <!-- Played part: sweeps from left to right like a play head. -->
                        <Border x:Name="Played" Background="{Binding Pad.LitPlayed}" Visibility="Collapsed"
                                RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Progress}" />
                            </Border.RenderTransform>
                        </Border>
                        <DockPanel Margin="12,10">
                            <Grid DockPanel.Dock="Bottom">
                                <!-- Dark ink under the text on a picture: soft above, solid where the text is. -->
                                <Border x:Name="Backdrop" Margin="{DynamicResource PadImageBackdropMargin}" Background="{DynamicResource PadImageBackdrop}" IsHitTestVisible="False"
                                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="Vol" DockPanel.Dock="Right" Text="{Binding VolumeText}" Style="{StaticResource Num}" FontSize="12" VerticalAlignment="Bottom" Margin="8,0,0,2"
                                               Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock x:Name="Status" Text="{Binding StatusText}" FontSize="12" Margin="0,0,0,2"
                                                   Visibility="{Binding StatusText, Converter={StaticResource TextToVis}}" />
                                        <TextBlock x:Name="PadName" Text="{Binding Name}" FontFamily="{DynamicResource FontPad}" FontSize="16" LineHeight="19"
                                                   LineStackingStrategy="BlockLineHeight" MaxHeight="57" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                            <Border />
                        </DockPanel>
                        <!-- Progress on a picture: a bar in the pad colour on the dark edge, readable on any picture. -->
                        <Grid x:Name="Bar" VerticalAlignment="Bottom" Margin="8,0,8,3" Height="{DynamicResource PadImageBarHeight}" Visibility="Collapsed" IsHitTestVisible="False"
                              views:RoundClip.Radius="2">
                            <Border Background="{DynamicResource PadImageTrack}" />
                            <Border Background="{Binding Pad.Lit}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Progress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                </Button>

                <!-- Top row: key cap (left), length (right). Short of room, the length gives way first;
                     then the cap shortens from the front ("…Shift+F12"), never the key itself. -->
                <views:PadTopRow VerticalAlignment="Top" Margin="11,8,12,0">
                    <Grid HorizontalAlignment="Left">
                        <!-- No own tab stop: the key is reached from the pad (right-click or Shift+F10 → "Assign key…"). -->
                        <Button x:Name="Cap" Style="{StaticResource KeyCap}" Command="{Binding KeyCapClickCommand}" HorizontalAlignment="Left" IsTabStop="False"
                                Background="{Binding Pad.CapBg}" BorderBrush="{Binding Pad.CapLine}" Foreground="{Binding Pad.Text}"
                                Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding HotkeyToolTip}">
                            <DockPanel>
                                <Path x:Name="CapWarn" Style="{StaticResource WarnIcon}" DockPanel.Dock="Left" Width="13" Height="12" Stretch="Uniform" Margin="0,0,5,0" StrokeThickness="1.5" VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                                <views:FitText Variants="{Binding HotkeyVariants}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        <!-- No key yet: a ghost cap appears on hover. -->
                        <Button x:Name="GhostCap" Style="{StaticResource KeyCap}" Command="{Binding AssignHotkeyCommand}" HorizontalAlignment="Left" IsTabStop="False"
                                Background="Transparent" BorderBrush="{Binding Pad.Line}" Foreground="{Binding Pad.Text}" FontFamily="{DynamicResource FontText}"
                                Content="{t:T Pad.Ghost}" ToolTip="{t:T Pad.GhostTip}" Visibility="Collapsed" />
                    </Grid>
                    <!-- Length (and the stop square while playing); on a picture it sits on a small ink chip. -->
                    <Border x:Name="DurChip" VerticalAlignment="Top" Margin="8,5,0,0" CornerRadius="5" IsHitTestVisible="False"
                            Visibility="{Binding DurationText, Converter={StaticResource TextToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle x:Name="StopGlyph" Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Margin="0,0,7,0"
                                       Fill="{Binding Pad.LitText}" Visibility="Collapsed" />
                            <TextBlock x:Name="Dur" Text="{Binding DurationText}" Style="{StaticResource Num}" FontSize="13" Foreground="{Binding Pad.Text}" />
                        </StackPanel>
                    </Border>
                </views:PadTopRow>

                <!-- A picture is dragged over this pad: it will take it. -->
                <Border CornerRadius="10" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3" IsHitTestVisible="False"
                        Visibility="{Binding IsImageDropTarget, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="5" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{t:T Pad.DropPicture}" Foreground="{DynamicResource OnAccentBrush}" FontSize="12" />
                    </Border>
                </Border>

                <!-- Just added: a ring in the accent colour for a moment, so the eye finds the new pads. -->
                <Border CornerRadius="13" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3" Margin="-5" IsHitTestVisible="False"
                        Visibility="{Binding IsJustAdded, Converter={StaticResource BoolToVis}}" />

                <!-- Rename in place -->
                <TextBox x:Name="RenameBox" Text="{Binding Name, UpdateSourceTrigger=Explicit}" VerticalAlignment="Bottom" Margin="8"
                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                         KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus" IsVisibleChanged="OnRenameVisibleChanged" />

                <!-- Waiting for a key -->
                <Border CornerRadius="10" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Padding="12,10"
                        Visibility="{Binding IsCapturingKey, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding CaptureHint}" TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{DynamicResource TextBrush}" />
                </Border>

                <!-- Problem of this pad: a notice field on the pad, with the way out. May grow over the row below. -->
                <Canvas Visibility="{Binding IsIssueOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource NoticeBox}" CornerRadius="10" Padding="10,8"
                        Width="{Binding ActualWidth, ElementName=Root}" MinHeight="{Binding ActualHeight, ElementName=Root}">
                    <StackPanel>
                        <DockPanel>
                            <Path Style="{StaticResource WarnIcon}" Margin="0,1,6,0" />
                            <TextBlock Text="{Binding IssueText}" TextWrapping="Wrap" FontSize="12" LineHeight="17" />
                        </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource NoticeButton}" Content="{Binding IssueActionText}" Command="{Binding RunIssueActionCommand}" FontSize="12"
                                    Margin="0,0,6,4" Visibility="{Binding HasIssueAction, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource NoticeButton}" Content="{t:T Common.Close}" Command="{Binding CloseIssueCommand}" FontSize="12" Margin="0,0,6,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                </Canvas>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Picture: light text on the ink, the length on its chip, the ghost key cap on its own ground. -->
                <DataTrigger Binding="{Binding HasImage}" Value="True">
                    <Setter TargetName="PadBtn" Property="Foreground" Value="{DynamicResource PadImageText}" />
                    <Setter TargetName="Dur" Property="Foreground" Value="{DynamicResource PadImageText}" />
                    <Setter TargetName="DurChip" Property="Background" Value="{DynamicResource PadImageChip}" />
                    <Setter TargetName="DurChip" Property="Padding" Value="6,1,6,2" />
                    <Setter TargetName="DurChip" Property="Margin" Value="8,4,0,0" />
                    <Setter TargetName="GhostCap" Property="Background" Value="{Binding Pad.CapBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="Glow" Property="Opacity" Value="1" />
                    <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PadBtn" Property="Background" Value="{Binding Pad.Lit}" />
                    <Setter TargetName="PadBtn" Property="BorderBrush" Value="{Binding Pad.LitLine}" />
                    <Setter TargetName="PadBtn" Property="Foreground" Value="{Binding Pad.LitText}" />
                    <Setter TargetName="Dur" Property="Foreground" Value="{Binding Pad.LitText}" />
                    <Setter TargetName="Played" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StopGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Picture playing: full brightness, the rim lights in the pad colour, the played part as a tint plus the bar. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasImage}" Value="True" />
                        <Condition Binding="{Binding IsPlaying}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="PadBtn" Property="Foreground" Value="{DynamicResource PadImageText}" />
                    <Setter TargetName="PadBtn" Property="BorderBrush" Value="{Binding Pad.Lit}" />
                    <Setter TargetName="Dur" Property="Foreground" Value="{DynamicResource PadImageText}" />
                    <Setter TargetName="StopGlyph" Property="Fill" Value="{DynamicResource PadImageText}" />
                    <Setter TargetName="Played" Property="Background" Value="{Binding Pad.LitSweep}" />
                    <Setter TargetName="Dim" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPlaying}" Value="True" />
                        <Condition Binding="{Binding AnimationsOn}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding HotkeyProblem}" Value="True">
                    <Setter TargetName="CapWarn" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Compact}" Value="True">
                    <Setter TargetName="PadName" Property="MaxHeight" Value="38" />
                    <Setter TargetName="PadName" Property="FontSize" Value="15" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="PadBtn" Property="BorderBrush" Value="{DynamicResource DiffText}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Root}" Value="True" />
                        <Condition Binding="{Binding HasHotkey}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="GhostCap" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="True" />
                        <Condition Binding="{Binding HasHotkey}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="GhostCap" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ============================================================ status line: one line, each part opens its tab -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0" Padding="10,2">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{t:T Status.SoundFolder}" Command="{Binding OpenSoundsFolderCommand}"
                        ToolTip="{Binding SoundsDir}" Foreground="{DynamicResource SubTextBrush}" />
                <WrapPanel>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding ShowSettingsCommand}" CommandParameter="{Binding StatusCableTab}"
                            ToolTip="{Binding StatusCableTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource WarnIcon}" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Visibility="{Binding CableWarn, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding StatusCable}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CableWarn}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Width="44" Height="6" Margin="8,0,0,0" Minimum="0" Maximum="1" Value="{Binding MixLevel, Mode=OneWay}" VerticalAlignment="Center"
                                         Visibility="{Binding CableRunning, Converter={StaticResource BoolToVis}}"
                                         ToolTip="{t:T Status.LevelTip}" />
                        </StackPanel>
                    </Button>
                    <!-- Microphone: muted shows the warning sign and bold text; a click unmutes. -->
                    <Button Style="{StaticResource LinkButton}" Command="{Binding MicStatusClickCommand}" Margin="12,0,0,0"
                            ToolTip="{Binding StatusMicTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource WarnIcon}" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Visibility="{Binding MicMuted, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding StatusMix}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MicMuted}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" Command="{Binding ShowSettingsCommand}" CommandParameter="tasten" Margin="12,0,0,0"
                            ToolTip="{t:T Status.KeysTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource WarnIcon}" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Visibility="{Binding HotkeyProblems, Converter={StaticResource PosToVis}}" />
                            <TextBlock Text="{Binding StatusHotkeys}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Windows audio: only there when something no longer works (no device, cable as default, muted); a click opens the Audio state tab. -->
                    <Button Style="{StaticResource LinkButton}" Command="{Binding ShowSettingsCommand}" CommandParameter="zustand" Margin="12,0,0,0"
                            ToolTip="{Binding StatusAudioTip}" AutomationProperties.Name="{Binding StatusAudioTip}"
                            Visibility="{Binding AudioWarn, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource WarnIcon}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{t:T Status.Audio}" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ header: only what is used while playing.
             Monitor · volume · search … Stop · settings (gear far right). Sounds are added by dragging, Ctrl+O,
             the right-click on the free pad area, or the button of the empty state. The tab order follows the
             arrangement (set in LayoutHeader), so it stays local to this grid. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid x:Name="HeaderGrid" KeyboardNavigation.TabNavigation="Local">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="MonitorGroup" Orientation="Horizontal" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Local">
                    <CheckBox Style="{StaticResource Switch}" Content="{t:T Main.Monitor}" IsChecked="{Binding MonitorEnabled}"
                              ToolTip="{t:T Main.MonitorTip}" />
                    <ComboBox ItemsSource="{Binding OutputChoices}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Display"
                              Width="190" Height="{StaticResource HeaderControlHeight}" Margin="12,0,0,0" ToolTip="{t:T Main.MonitorDeviceTip}" AutomationProperties.Name="{t:T Main.MonitorDeviceTip}" />
                </StackPanel>
                <StackPanel x:Name="VolumeGroup" Grid.Column="1" Orientation="Horizontal" Margin="16,0,16,0" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Local">
                    <views:VolumeIcon Percent="{Binding MasterVolumePercent}" Stroke="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                      Text="{t:T Main.VolumeAll}" MutedText="{t:T Main.VolumeMuted}" />
                    <Slider Minimum="0" Maximum="100" Width="110" Margin="8,0,8,0" VerticalAlignment="Center"
                            Value="{Binding MasterVolumePercent}" SmallChange="1" LargeChange="10"
                            AutomationProperties.Name="{t:T Main.VolumeAll}"
                            ToolTip="{t:T Main.VolumeAllTip}" />
                    <TextBlock Text="{Binding MasterVolumeText}" Width="40" Style="{StaticResource Num}" />
                </StackPanel>
                <!-- Search: always there. Ctrl+F jumps here, Esc empties it. -->
                <Grid x:Name="SearchGroup" Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" MinWidth="150" MaxWidth="280" HorizontalAlignment="Stretch"
                      KeyboardNavigation.TabNavigation="Local">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="16,2,16,2" Height="{StaticResource HeaderControlHeight}" VerticalContentAlignment="Center"
                             AutomationProperties.Name="{t:T Search.Placeholder}" ToolTip="{t:T Search.Tip}" KeyDown="OnSearchKeyDown" />
                    <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 6.49,1 Z M 10.6,10.6 L 15,15" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.6"
                          Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="{t:T Search.Placeholder}" Foreground="{DynamicResource SubTextBrush}" Margin="32,0,32,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding SearchText, Converter={StaticResource TextToVis}, ConverterParameter=invert}" />
                    <Button Style="{StaticResource LinkButton}" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="28" Height="28" Padding="0" Margin="0,0,2,0" ToolTip="{t:T Search.Clear}" AutomationProperties.Name="{t:T Search.Clear}"
                            Visibility="{Binding SearchActive, Converter={StaticResource BoolToVis}}">
                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" Width="10" Height="10" />
                    </Button>
                </Grid>
                <Button x:Name="StopButton" Grid.Column="3" Style="{StaticResource StopButton}" Content="{t:T Main.Stop}" Height="{StaticResource HeaderControlHeight}" VerticalAlignment="Center"
                        Command="{Binding StopAllCommand}" ToolTip="{Binding StopAllToolTip}" />
                <Button x:Name="SettingsButton" Grid.Column="4" Style="{StaticResource IconButton}" Command="{Binding ShowSettingsCommand}" CommandParameter=""
                        Width="{StaticResource HeaderControlHeight}" Height="{StaticResource HeaderControlHeight}" Margin="8,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.Name="{t:T Settings.Title}"
                        ToolTip="{t:T Main.SettingsTip}" views:GearMotion.IsEnabled="True">
                    <!-- Turns by one tooth on mouse-over (GearMotion), about its centre. -->
                    <Path Data="{StaticResource GearGeometry}" Fill="{DynamicResource TextBrush}" Width="20" Height="20" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform />
                        </Path.RenderTransform>
                    </Path>
                </Button>
            </Grid>
        </Border>

        <!-- ============================================================ the one notice -->
        <Border DockPanel.Dock="Top" Style="{StaticResource NoticeBox}" Margin="16,12,16,0"
                Visibility="{Binding CurrentNotice.Text, Converter={StaticResource TextToVis}, FallbackValue=Collapsed}">
            <DockPanel>
                <WrapPanel x:Name="NoticeButtons" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource NoticeButton}" Content="{Binding CurrentNotice.ActionText}" Command="{Binding CurrentNotice.RunActionCommand}" Margin="0,0,8,0"
                            Visibility="{Binding CurrentNotice.HasAction, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                    <Button Style="{StaticResource NoticeButton}" Command="{Binding NextNoticeCommand}" Margin="0,0,8,0"
                            Visibility="{Binding NoticeCountText, Converter={StaticResource TextToVis}}" ToolTip="{t:T Notice.NextTip}">
                        <TextBlock>
                            <Run Text="{t:T Notice.Next}" /><Run Text=" (" /><Run Text="{Binding NoticeCountText, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource NoticeButton}" Content="{t:T Common.Close}" Command="{Binding CurrentNotice.CloseCommand}" />
                </WrapPanel>
                <Path Style="{StaticResource WarnIcon}" Margin="0,1,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentNotice.Text}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="20" />
            </DockPanel>
        </Border>

        <!-- ============================================================ pads, empty state, settings -->
        <Grid>
            <!-- Right-click on the free area between and below the pads (a pad has its own menu). -->
            <ScrollViewer x:Name="PadScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Background="Transparent">
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{t:T Main.AddSounds}" Command="{Binding AddFilesDialogCommand}" InputGestureText="{t:T Main.AddSoundsKey}"
                                  ToolTip="{t:T Main.AddSoundsTip}" />
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <Grid>
                <!-- Tab enters the grid once (and leaves it); the arrow keys move between the pads. -->
                <ItemsControl x:Name="PadList" ItemsSource="{Binding Tiles}" Margin="16,16,16,20" ItemTemplate="{StaticResource PadTemplate}" Focusable="False"
                              KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="None">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:PadPanel MinPadWidth="160" Gap="12" Compact="{Binding CompactPads}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIssueOpen}" Value="True">
                                    <Setter Property="Panel.ZIndex" Value="10" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFilteredOut}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
                <!-- While a pad is dragged: the insert mark between the pads. -->
                <Canvas x:Name="DragLayer" IsHitTestVisible="False">
                    <Rectangle x:Name="InsertMark" Width="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                </Canvas>
                </Grid>
            </ScrollViewer>

            <!-- Empty: an inviting drop pad -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="460"
                  Visibility="{Binding HasNoTiles, Converter={StaticResource BoolToVis}}">
                <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource LineBrush}" StrokeThickness="2" StrokeDashArray="5 3" Fill="{DynamicResource FieldBg}" />
                <StackPanel Margin="36,30">
                    <Canvas Width="68" Height="56" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="20" Height="16" RadiusX="4" RadiusY="4" Fill="{DynamicResource AccentBrush}" />
                        <Rectangle Canvas.Left="24" Canvas.Top="0" Width="20" Height="16" RadiusX="4" RadiusY="4" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="48" Canvas.Top="0" Width="20" Height="16" RadiusX="4" RadiusY="4" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="0" Canvas.Top="20" Width="20" Height="16" RadiusX="4" RadiusY="4" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="24" Canvas.Top="20" Width="20" Height="16" RadiusX="4" RadiusY="4" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="48" Canvas.Top="20" Width="20" Height="16" RadiusX="4" RadiusY="4" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="0" Canvas.Top="40" Width="20" Height="16" RadiusX="4" RadiusY="4" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="24" Canvas.Top="40" Width="20" Height="16" RadiusX="4" RadiusY="4" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" />
                        <Rectangle Canvas.Left="48" Canvas.Top="40" Width="20" Height="16" RadiusX="4" RadiusY="4" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5" />
                    </Canvas>
                    <TextBlock Text="{t:T Empty.Title}" FontFamily="{DynamicResource FontPad}" FontSize="24" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource P}" Margin="0,8,0,0"
                               Text="{t:T Empty.Text}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{t:T Main.AddSounds}" Command="{Binding AddFilesDialogCommand}"
                            ToolTip="{t:T Main.AddSoundsTip}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                </StackPanel>
            </Grid>

            <!-- Search without a match: say so, and the way back. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,48,24,24" MaxWidth="460"
                        Visibility="{Binding SearchHasNoResults, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SearchNoResultsText}" Style="{StaticResource P}" TextAlignment="Center" />
                <Button Content="{t:T Search.Clear}" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <!-- ======================================================== settings: covers the pads, header stays -->
            <!-- Shown and hidden by PanelMotion (code-behind, from SettingsOpen): it opens from the gear and closes back to it. -->
            <Border x:Name="SettingsPanel" Background="{DynamicResource WindowBg}" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="16,12,16,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{t:T Common.Close}" Command="{Binding CloseSettingsCommand}" VerticalAlignment="Center"
                                        ToolTip="{t:T Settings.CloseTip}" />
                                <TextBlock Text="{t:T Settings.Title}" FontSize="{DynamicResource SizeTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel>
                                <WrapPanel Margin="-12,6,0,0">
                                    <RadioButton Style="{StaticResource Tab}" GroupName="SettingsTabs" Content="{t:T Tab.Setup}"
                                                 IsChecked="{Binding SettingsTab, Converter={StaticResource Eq}, ConverterParameter=einrichtung}" />
                                    <RadioButton Style="{StaticResource Tab}" GroupName="SettingsTabs" Content="{t:T Tab.Cable}"
                                                 IsChecked="{Binding SettingsTab, Converter={StaticResource Eq}, ConverterParameter=kabel}" />
                                    <RadioButton Style="{StaticResource Tab}" GroupName="SettingsTabs" Content="{t:T Tab.Keys}"
                                                 IsChecked="{Binding SettingsTab, Converter={StaticResource Eq}, ConverterParameter=tasten}" />
                                    <RadioButton Style="{StaticResource Tab}" GroupName="SettingsTabs" Content="{t:T Tab.State}"
                                                 IsChecked="{Binding SettingsTab, Converter={StaticResource Eq}, ConverterParameter=zustand}" />
                                    <RadioButton Style="{StaticResource Tab}" GroupName="SettingsTabs" Content="{t:T Tab.Appearance}"
                                                 IsChecked="{Binding SettingsTab, Converter={StaticResource Eq}, ConverterParameter=design}" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="16,16,16,24" MaxWidth="780" HorizontalAlignment="Left">

                            <!-- ............................................ Einrichtung -->
                            <StackPanel Visibility="{Binding SettingsTab, Converter={StaticResource EqToVis}, ConverterParameter=einrichtung}">
                                <WrapPanel Margin="0,0,0,12">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="SetupSteps" Content="{t:T Setup.Step1}"
                                                 IsChecked="{Binding SetupStepText, Converter={StaticResource Eq}, ConverterParameter=1}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="SetupSteps" Content="{t:T Setup.Step2}"
                                                 IsChecked="{Binding SetupStepText, Converter={StaticResource Eq}, ConverterParameter=2}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="SetupSteps" Content="{t:T Setup.Step3}"
                                                 IsChecked="{Binding SetupStepText, Converter={StaticResource Eq}, ConverterParameter=3}" />
                                </WrapPanel>

                                <!-- Step 1: cable -->
                                <StackPanel Visibility="{Binding IsSetupStep1, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource P}" Margin="0,0,0,12"
                                               Text="{t:T Setup.Intro}" />

                                    <!-- No cable: the one place that explains the way (the status line only names it). -->
                                    <Border Style="{StaticResource NoticeBox}" Padding="14,10" Visibility="{Binding CableFound, Converter={StaticResource NotBoolToVis}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Path Style="{StaticResource WarnIcon}" Margin="0,1,8,0" />
                                                <TextBlock Text="{Binding CableStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock TextWrapping="Wrap" Margin="26,4,0,0" LineHeight="20">
                                                <Run Text="{t:T Setup.NeedCable}" />
                                                <Hyperlink Command="{Binding OpenCableWebsiteCommand}" Foreground="{DynamicResource TextBrush}">vb-cable.com</Hyperlink><Run Text="{t:T Setup.NeedCableTail}" />
                                            </TextBlock>
                                            <TextBlock TextWrapping="Wrap" Margin="26,8,0,0" LineHeight="20">
                                                <Run Text="{t:T Setup.C1}" /><LineBreak />
                                                <Run Text="{t:T Setup.C2}" /><LineBreak />
                                                <Run Text="{t:T Setup.C3}" />
                                            </TextBlock>
                                            <WrapPanel Margin="26,8,0,0">
                                                <Button Style="{StaticResource NoticeButton}" Content="{t:T Setup.OpenSite}" Command="{Binding OpenCableWebsiteCommand}" Margin="0,0,8,6" />
                                                <Button Style="{StaticResource NoticeButton}" Content="{t:T Setup.SearchCable}" Command="{Binding SearchCableCommand}" Margin="0,0,8,6" />
                                            </WrapPanel>
                                            <!-- The soundboard saves the audio state by itself; the setup only says so. -->
                                            <TextBlock Text="{t:T Setup.AutoSave}" Margin="26,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Visibility="{Binding CableFound, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding CableStatusText}" Style="{StaticResource P}" />
                                        <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource LineSoft}" Background="{DynamicResource FieldBg}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{t:T Action.Restore}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding RestoreDefaultsCommand}"
                                                        Visibility="{Binding CableCompareProblem, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="{t:T Restore.Tip}" />
                                                <TextBlock Text="{Binding CableCompareText}" Style="{StaticResource P}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="{Binding RestoreResultText}" Margin="0,6,0,0" Style="{StaticResource P}"
                                                   Visibility="{Binding RestoreResultText, Converter={StaticResource TextToVis}}" />
                                        <CheckBox Style="{StaticResource Switch}" Content="{t:T Setup.SendToCable}" IsChecked="{Binding CableEnabled}" Margin="0,16,0,0" />
                                        <TextBlock Text="{t:T Setup.Level}" Style="{StaticResource H2}" Margin="0,18,0,6" />
                                        <StackPanel Orientation="Horizontal">
                                            <ProgressBar Width="280" Height="10" Minimum="0" Maximum="1" Value="{Binding MixLevel, Mode=OneWay}" VerticalAlignment="Center" />
                                            <Button Content="{t:T Setup.TestTone}" Margin="12,0,0,0" Command="{Binding PlayTestToneCommand}"
                                                    ToolTip="{t:T Setup.TestToneTip1}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                                                   Text="{t:T Setup.LevelHint1}" />
                                    </StackPanel>

                                    <Button Style="{StaticResource PrimaryButton}" Content="{t:T Setup.Next2}" Command="{Binding GoToStepCommand}" CommandParameter="2"
                                            HorizontalAlignment="Left" Margin="0,20,0,0" />
                                </StackPanel>

                                <!-- Step 2: Discord -->
                                <StackPanel Visibility="{Binding IsSetupStep2, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource P}" Margin="0,0,0,10"
                                               Text="{t:T Setup.DiscordIntro}" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="23">
                                        <Run Text="{t:T Setup.D1}" /><LineBreak />
                                        <Run Text="{t:T Setup.D2}" /><LineBreak />
                                        <Run Text="{t:T Setup.D3}" /><LineBreak />
                                        <Run Text="{t:T Setup.D4}" />
                                    </TextBlock>

                                    <TextBlock Text="{t:T Setup.PrevMic}" Style="{StaticResource H2}" />
                                    <TextBox Text="{Binding DiscordPreviousMic, UpdateSourceTrigger=PropertyChanged}" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320"
                                             ToolTip="{t:T Setup.PrevMicTip}" AutomationProperties.Name="{t:T Setup.PrevMic}" />
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                                               Text="{t:T Setup.PrevMicHint}" />

                                    <TextBlock Text="{t:T Setup.Level}" Style="{StaticResource H2}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ProgressBar Width="280" Height="10" Minimum="0" Maximum="1" Value="{Binding MixLevel, Mode=OneWay}" VerticalAlignment="Center" />
                                        <Button Content="{t:T Setup.TestTone}" Margin="12,0,0,0" Command="{Binding PlayTestToneCommand}"
                                                ToolTip="{t:T Setup.TestToneTip2}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                                               Text="{t:T Setup.LevelHint2}" />

                                    <Button Style="{StaticResource PrimaryButton}" Content="{t:T Setup.Next3}" Command="{Binding GoToStepCommand}" CommandParameter="3"
                                            HorizontalAlignment="Left" Margin="0,20,0,0" />
                                </StackPanel>

                                <!-- Step 3: noise suppression -->
                                <StackPanel Visibility="{Binding IsSetupStep3, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource P}" Margin="0,0,0,10"
                                               Text="{t:T Setup.NoiseIntro}" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="23">
                                        <Run Text="{t:T Setup.N1}" /><LineBreak />
                                        <Run Text="{t:T Setup.N2}" /><LineBreak />
                                        <Run Text="{t:T Setup.N3}" />
                                    </TextBlock>
                                    <TextBlock Text="{t:T Setup.PttTitle}" Style="{StaticResource H2}" />
                                    <TextBlock Style="{StaticResource P}"
                                               Text="{t:T Setup.Ptt}" />
                                    <TextBlock Style="{StaticResource Sub}" Margin="0,12,0,0"
                                               Text="{t:T Setup.NoiseCheckHint}" />
                                    <CheckBox Content="{t:T Setup.NoiseDone}" IsChecked="{Binding DiscordSettingsDone}" Margin="0,8,0,0" />

                                    <!-- The last word: the whole path in one line, with the live level, and a pad to try it. -->
                                    <Border Margin="0,24,0,0" Padding="14,12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource LineSoft}"
                                            Background="{DynamicResource FieldBg}" HorizontalAlignment="Left" MaxWidth="608">
                                        <StackPanel>
                                            <TextBlock Text="{t:T Setup.FinalLine}" Style="{StaticResource P}" FontWeight="SemiBold" />
                                            <ProgressBar Width="280" Height="10" Minimum="0" Maximum="1" Value="{Binding MixLevel, Mode=OneWay}" HorizontalAlignment="Left"
                                                         Margin="0,10,0,0" ToolTip="{t:T Status.LevelTip}" />
                                        </StackPanel>
                                    </Border>

                                    <Button Style="{StaticResource PrimaryButton}" Content="{t:T Setup.Finish}" Command="{Binding FinishSetupCommand}"
                                            HorizontalAlignment="Left" Margin="0,16,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- ............................................ Mikrofon & Kabel -->
                            <StackPanel Visibility="{Binding SettingsTab, Converter={StaticResource EqToVis}, ConverterParameter=kabel}">
                                <CheckBox Style="{StaticResource Switch}" Content="{t:T Setup.SendToCable}" IsChecked="{Binding CableEnabled}"
                                          ToolTip="{t:T Cable.SendTip}" />
                                <TextBlock Text="{Binding StatusCable}" Style="{StaticResource Sub}" Margin="48,2,0,0" />

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{t:T Cable.Mic}" Style="{StaticResource FormLabel}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MicChoices}" SelectedItem="{Binding SelectedMic}" DisplayMemberPath="Display"
                                              MaxWidth="400" HorizontalAlignment="Left" MinWidth="260"
                                              ToolTip="{t:T Cable.MicTip}" AutomationProperties.Name="{t:T Cable.Mic}" />

                                    <TextBlock Grid.Row="2" Text="{t:T Cable.MicVolume}" Style="{StaticResource FormLabel}" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <Slider Minimum="0" Maximum="200" Width="200" VerticalAlignment="Center" Value="{Binding MicVolumePercent}" SmallChange="1" LargeChange="10"
                                                AutomationProperties.Name="{t:T Cable.MicVolume}" ToolTip="{t:T Cable.MicVolumeTip}" />
                                        <TextBlock Text="{Binding MicVolumeText}" Width="48" Margin="10,0,0,0" Style="{StaticResource Num}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Text="{t:T Cable.Level}" Style="{StaticResource FormLabel}" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                        <ProgressBar Width="200" Height="10" Minimum="0" Maximum="1" Value="{Binding MixLevel, Mode=OneWay}" VerticalAlignment="Center" />
                                        <Button Content="{t:T Setup.TestTone}" Margin="12,0,0,0" Command="{Binding PlayTestToneCommand}"
                                                ToolTip="{t:T Cable.TestToneTip}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="6" Text="{t:T Cable.Buffer}" Style="{StaticResource FormLabel}" />
                                    <StackPanel Grid.Row="6" Grid.Column="1">
                                        <ComboBox ItemsSource="{Binding BufferChoices}" SelectedItem="{Binding SelectedBuffer}" DisplayMemberPath="Display"
                                                  Width="180" HorizontalAlignment="Left" AutomationProperties.Name="{t:T Cable.Buffer}" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{t:T Cable.BufferHint}" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Style="{StaticResource Switch}" Content="{t:T Cable.BlockVoice}" IsChecked="{Binding BlockVoice}" Margin="0,20,0,0"
                                          ToolTip="{t:T Cable.BlockVoiceTip}" />

                                <TextBlock Text="{t:T Cable.TestTitle}" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Text="{t:T Cable.TestText}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{t:T Cable.Record}" Command="{Binding RecordTestCommand}" Margin="0,0,12,6" />
                                    <Button Content="{t:T Cable.ShowFile}" Command="{Binding ShowTestFileCommand}" Margin="0,0,12,6"
                                            Visibility="{Binding HasTestFile, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding TestStatus}" VerticalAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap" MaxWidth="420" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- ............................................ Tasten -->
                            <StackPanel Visibility="{Binding SettingsTab, Converter={StaticResource EqToVis}, ConverterParameter=tasten}">
                                <CheckBox Style="{StaticResource Switch}" Content="{t:T Keys.Pause}" IsChecked="{Binding HotkeysPaused}"
                                          ToolTip="{t:T Keys.PauseTip}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="48,2,0,0"
                                           Text="{t:T Keys.PauseHint}" />

                                <TextBlock Text="{t:T Keys.PadKeys}" Style="{StaticResource H2}" />
                                <!-- One list: the function keys ("Stop all sounds" first), then every pad. All rows are built alike. -->
                                <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource FieldBg}"
                                        Grid.IsSharedSizeScope="True">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding FunctionKeys}" ItemTemplate="{StaticResource KeyRowTemplate}" Focusable="False" />
                                        <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource KeyRowTemplate}" Focusable="False" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" Visibility="{Binding HasNoTiles, Converter={StaticResource BoolToVis}}"
                                           Text="{t:T Keys.NoPads}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" Text="{t:T Keys.NumLockHint}" />

                                <TextBlock Text="{t:T Keys.Playing}" Style="{StaticResource H2}" />
                                <CheckBox Style="{StaticResource Switch}" Content="{t:T Keys.Overlay}" IsChecked="{Binding OverlayEnabled}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="48,2,0,0"
                                           Text="{t:T Keys.OverlayHint}" />
                                <!-- What the key of a playing pad does. -->
                                <TextBlock Text="{t:T Keys.SameKey}" Margin="0,20,0,8" FontWeight="SemiBold" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="SameKey" Content="{t:T Keys.SameKeyStop}"
                                                 IsChecked="{Binding SameKeyAgain, Converter={StaticResource Eq}, ConverterParameter=Stop}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="SameKey" Content="{t:T Keys.SameKeyRestart}"
                                                 IsChecked="{Binding SameKeyAgain, Converter={StaticResource Eq}, ConverterParameter=Restart}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" Text="{t:T Keys.SameKeyHint}" />
                            </StackPanel>

                            <!-- ............................................ Audio-Zustand -->
                            <StackPanel Visibility="{Binding SettingsTab, Converter={StaticResource EqToVis}, ConverterParameter=zustand}">
                                <!-- Only when something no longer works – the same as the "!" in the status line, in full. -->
                                <Border Style="{StaticResource NoticeBox}" Padding="14,10" Margin="0,0,0,16"
                                        Visibility="{Binding AudioWarn, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Path Style="{StaticResource WarnIcon}" Margin="0,1,8,0" />
                                            <TextBlock Text="{t:T State.ProblemTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding AudioProblemText}" Margin="26,4,0,0" TextWrapping="Wrap" LineHeight="20" />
                                        <TextBlock Text="{Binding AudioProblemHint}" Margin="26,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}"
                                                   Visibility="{Binding AudioProblemHint, Converter={StaticResource TextToVis}}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding SnapshotHeader}" FontSize="{DynamicResource SizeGroup}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource P}" Margin="0,8,0,0" Text="{Binding SnapshotAdvice}"
                                           Visibility="{Binding SnapshotAdvice, Converter={StaticResource TextToVis}}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="{t:T Action.Restore}" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,8,6"
                                            Visibility="{Binding SnapshotAdvice, Converter={StaticResource TextToVis}}"
                                            ToolTip="{t:T Restore.Tip}" />
                                    <Button Content="{t:T Action.SaveState}" Command="{Binding SaveSnapshotNowCommand}" Margin="0,0,8,6"
                                            ToolTip="{t:T State.SaveTip}" />
                                    <Button Content="{t:T State.CompareAgain}" Command="{Binding CompareAgainCommand}" Margin="0,0,8,6" />
                                </WrapPanel>
                                <TextBlock Text="{Binding RestoreResultText}" Style="{StaticResource P}" Margin="0,4,0,0"
                                           Visibility="{Binding RestoreResultText, Converter={StaticResource TextToVis}}" />
                                <DataGrid ItemsSource="{Binding ComparisonRows}" Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{t:T Grid.What}" Binding="{Binding What}" Width="2*" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{t:T Grid.Saved}" Binding="{Binding Saved}" Width="2*" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{t:T Grid.Now}" Binding="{Binding Now}" Width="2*" />
                                        <DataGridTemplateColumn Header="{t:T Grid.Result}" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="K" Text="{Binding KindText}" FontWeight="SemiBold" Foreground="{DynamicResource DiffText}" Margin="4,0" />
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="Same">
                                                            <Setter TargetName="K" Property="Foreground" Value="{DynamicResource OkText}" />
                                                            <Setter TargetName="K" Property="FontWeight" Value="Normal" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding SnapshotInfo}" Style="{StaticResource Sub}" Margin="0,6,0,0" />

                                <TextBlock Text="{t:T State.Devices}" Style="{StaticResource H2}" Margin="0,28,0,4" />
                                <TextBlock Text="{Binding DevicesHeader}" Style="{StaticResource Sub}" />
                                <WrapPanel Margin="0,10,0,8">
                                    <Button Content="{t:T State.Reread}" Command="{Binding RefreshDevicesCommand}" Margin="0,0,16,0" />
                                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding ShowNotPresent}"
                                              Content="{Binding NotPresentText}"
                                              ToolTip="{t:T State.NotPresentTip}" />
                                </WrapPanel>
                                <!-- No height limit: the page scrolls, not the table. The ID is in the tooltip of each row. -->
                                <DataGrid ItemsSource="{Binding Devices}">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="ToolTip" Value="{Binding IdTip}" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn ElementStyle="{StaticResource CellOneLine}" Header="{t:T Grid.Flow}" Binding="{Binding Flow}" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{t:T Grid.Name}" Binding="{Binding Name}" Width="*" MinWidth="160" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellOneLine}" Header="{t:T Grid.Status}" Binding="{Binding Status}" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="{t:T Grid.Default}" Binding="{Binding Default}" Width="Auto" MaxWidth="180" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellOneLine}" Header="{t:T Grid.Volume}" Binding="{Binding Volume}" />
                                        <DataGridTextColumn ElementStyle="{StaticResource CellOneLine}" Header="{t:T Grid.Format}" Binding="{Binding Format}" />

                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <!-- ............................................ Appearance: language, light/dark, accent, pads, motion -->
                            <StackPanel Visibility="{Binding SettingsTab, Converter={StaticResource EqToVis}, ConverterParameter=design}">
                                <TextBlock Text="{t:T Design.Language}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <!-- The names stay in their own language, so anyone finds theirs. -->
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Language" Content="English" Language="en-GB"
                                                 IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=en}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Language" Content="Deutsch" Language="de-DE"
                                                 IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=de}" />
                                </WrapPanel>

                                <TextBlock Text="{t:T Design.Mode}" Style="{StaticResource H2}" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Appearance" Content="{t:T Design.System}"
                                                 IsChecked="{Binding Appearance, Converter={StaticResource Eq}, ConverterParameter=System}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Appearance" Content="{t:T Design.Light}"
                                                 IsChecked="{Binding Appearance, Converter={StaticResource Eq}, ConverterParameter=Hell}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Appearance" Content="{t:T Design.Dark}"
                                                 IsChecked="{Binding Appearance, Converter={StaticResource Eq}, ConverterParameter=Dunkel}" />
                                </WrapPanel>

                                <TextBlock Text="{t:T Design.Accent}" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10" Text="{t:T Design.AccentText}" />
                                <ItemsControl ItemsSource="{Binding AccentChoices}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" IsChecked="{Binding IsSelected}"
                                                         AutomationProperties.Name="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Custom colour: picker (drag or arrow keys), applied at once; hex only as a small extra. -->
                                <Grid Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="{Binding CustomAccentSelected, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <views:ColorPicker x:Name="AccentPicker" SelectedColor="{Binding CustomAccentColor, Mode=TwoWay}"
                                                       AreaName="{t:T Design.PickerArea}" HueName="{t:T Design.PickerHue}" ToolTip="{t:T Design.PickerTip}"
                                                       ToolTipService.InitialShowDelay="900" />
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{t:T Design.Preview}" Style="{StaticResource Sub}" Margin="0,0,0,6" />
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="16,7" HorizontalAlignment="Left">
                                            <TextBlock Text="{t:T Design.PreviewButton}" Foreground="{DynamicResource OnAccentBrush}" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{t:T Design.PreviewText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <TextBlock Text="{t:T Design.Hex}" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Width="96" Text="{Binding CustomAccentText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource FontDisplay}"
                                                     LostKeyboardFocus="OnHexLostFocus" KeyDown="OnHexKeyDown"
                                                     ToolTip="{t:T Design.HexTip}" AutomationProperties.Name="{t:T Design.HexTip}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <!-- Quiet line: how the colour is used if it had to be adjusted. Grey info mark, no amber. -->
                                <DockPanel Margin="0,8,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                           Visibility="{Binding CustomAccentHint, Converter={StaticResource TextToVis}}">
                                    <Path Style="{StaticResource InfoIcon}" Margin="0,2,8,0" />
                                    <TextBlock Style="{StaticResource Sub}" Text="{Binding CustomAccentHint}" />
                                </DockPanel>

                                <TextBlock Text="{t:T Design.PadColours}" Style="{StaticResource H2}" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="PadColors" Content="{t:T Design.Colourful}"
                                                 IsChecked="{Binding PadColorMode, Converter={StaticResource Eq}, ConverterParameter=Bunt}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="PadColors" Content="{t:T Design.AllAccent}"
                                                 IsChecked="{Binding PadColorMode, Converter={StaticResource Eq}, ConverterParameter=Akzent}" />
                                </WrapPanel>

                                <TextBlock Text="{t:T Design.PadSize}" Style="{StaticResource H2}" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="PadSize" Content="{t:T Design.PadLarge}"
                                                 IsChecked="{Binding PadSize, Converter={StaticResource Eq}, ConverterParameter=Large}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="PadSize" Content="{t:T Design.PadCompact}"
                                                 IsChecked="{Binding PadSize, Converter={StaticResource Eq}, ConverterParameter=Compact}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" Text="{t:T Design.PadSizeHint}" />

                                <TextBlock Text="{t:T Design.Motion}" Style="{StaticResource H2}" />
                                <CheckBox Style="{StaticResource Switch}" Content="{t:T Design.Glow}" IsChecked="{Binding Animations}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="48,2,0,0"
                                           Text="{t:T Design.GlowHint}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="48,2,0,0" Visibility="{Binding WindowsAnimationsOff, Converter={StaticResource BoolToVis}}"
                                           Text="{t:T Design.WindowsOff}" />

                                <!-- Profile: pads with sounds and pictures as one ZIP file, out and in. -->
                                <TextBlock Text="{t:T Profile.Title}" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,10" MaxWidth="608" HorizontalAlignment="Left" Text="{t:T Profile.Text}" />
                                <WrapPanel>
                                    <Button Content="{t:T Profile.Export}" Command="{Binding ExportProfileCommand}" Margin="0,0,8,6" ToolTip="{t:T Profile.ExportTip}" />
                                    <Button Content="{t:T Profile.Import}" Command="{Binding ImportProfileCommand}" Margin="0,0,8,6" ToolTip="{t:T Profile.ImportTip}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ProfileResultText}" Style="{StaticResource Sub}" Margin="0,2,0,0" MaxWidth="608" HorizontalAlignment="Left"
                                           Visibility="{Binding ProfileResultText, Converter={StaticResource TextToVis}}" />
                                <!-- The file cannot be used: why, and the way to another file. -->
                                <Border Style="{StaticResource NoticeBox}" Padding="14,10" Margin="0,8,0,0" MaxWidth="608" HorizontalAlignment="Left"
                                        Visibility="{Binding ProfileErrorText, Converter={StaticResource TextToVis}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Path Style="{StaticResource WarnIcon}" Margin="0,1,8,0" />
                                            <TextBlock Text="{Binding ProfileErrorText}" TextWrapping="Wrap" LineHeight="20" />
                                        </DockPanel>
                                        <Button Style="{StaticResource NoticeButton}" Content="{t:T Profile.OtherFile}" Command="{Binding ImportProfileCommand}"
                                                HorizontalAlignment="Left" Margin="26,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <!-- Preview: what the file holds, then the choice. Nothing has changed yet. -->
                                <Border Margin="0,8,0,0" Padding="14,12" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource FieldBg}"
                                        MaxWidth="608" HorizontalAlignment="Left" Visibility="{Binding HasImportPreview, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImportPreviewText}" Style="{StaticResource P}" FontWeight="SemiBold" />
                                        <CheckBox Content="{t:T Profile.EvenOut}" IsChecked="{Binding EvenOutOnImport}" Margin="0,10,0,0" ToolTip="{t:T Profile.EvenOutTip}" />
                                        <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0" Text="{t:T Profile.BackupHint}" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="{t:T Profile.Add}" Command="{Binding ImportAddCommand}" Margin="0,0,8,6" />
                                            <Button Content="{t:T Profile.Replace}" Command="{Binding ImportReplaceCommand}" Margin="0,0,8,6" ToolTip="{t:T Profile.ReplaceTip}" />
                                            <Button Content="{t:T Common.Cancel}" Command="{Binding CancelImportCommand}" Margin="0,0,8,6" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Start with Windows: the real Run entry, also one the installer set. -->
                                <TextBlock Text="{t:T Autostart.Title}" Style="{StaticResource H2}" />
                                <CheckBox Style="{StaticResource Switch}" Content="{t:T Autostart.Switch}" IsChecked="{Binding AutostartOn}" />
                                <TextBlock Style="{StaticResource Sub}" Margin="48,2,0,0" Text="{t:T Autostart.Hint}" />
                                <!-- Quiet line: the entry starts another copy (moved EXE, old portable copy). -->
                                <DockPanel Margin="48,8,0,0" MaxWidth="560" HorizontalAlignment="Left"
                                           Visibility="{Binding AutostartOtherText, Converter={StaticResource TextToVis}}">
                                    <Path Style="{StaticResource InfoIcon}" Margin="0,2,8,0" />
                                    <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap">
                                        <Run Text="{Binding AutostartOtherText, Mode=OneWay}" /><Run Text=" – " /><Hyperlink Command="{Binding UseThisCopyForAutostartCommand}" Foreground="{DynamicResource TextBrush}"><Run Text="{t:T Autostart.UseThisCopy}" /></Hyperlink>
                                    </TextBlock>
                                </DockPanel>
                                <!-- Windows refused the change: the switch sprang back, the reason stands here. -->
                                <Border Style="{StaticResource NoticeBox}" Padding="14,10" Margin="0,10,0,0" MaxWidth="608" HorizontalAlignment="Left"
                                        Visibility="{Binding AutostartError, Converter={StaticResource TextToVis}}">
                                    <DockPanel>
                                        <Path Style="{StaticResource WarnIcon}" Margin="0,1,8,0" />
                                        <TextBlock Text="{Binding AutostartError}" TextWrapping="Wrap" LineHeight="20" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
