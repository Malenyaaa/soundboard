<Window x:Class="Soundboard.App.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundboard entfernen"
        Width="760" Height="780" MinWidth="480" MinHeight="400" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="P" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style x:Key="B" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NoticeBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NoticeLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Button Content="Schließen" Padding="16,5" HorizontalAlignment="Right" Click="OnClose" IsCancel="True" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,8,20,20" MaxWidth="700" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource P}" Margin="0,10,0,0"
                           Text="Diese Anleitung führt durch den Rückbau: Audio-Zustand prüfen, die eigenen Daten des Soundboards löschen und das virtuelle Kabel entfernen. Nichts davon passiert still – jeder Schritt startet erst auf deinen Klick." />

                <Border x:Name="RunningBox" Style="{StaticResource Notice}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource P}" Foreground="{DynamicResource NoticeText}"
                                   Text="Das Soundboard läuft noch. Beende es zuerst: Rechtsklick auf das Notensymbol im Infobereich → „Beenden …“. Diese Anleitung merkt es von selbst." />
                    </StackPanel>
                </Border>

                <!-- 1 -->
                <TextBlock Style="{StaticResource H}" Text="1. Audio-Zustand prüfen" />
                <TextBlock x:Name="StateText" Style="{StaticResource P}" />
                <Button x:Name="RestoreButton" Style="{StaticResource B}" Content="Wie vorher" Click="OnRestore"
                        ToolTip="Stellt die Windows-Standardgeräte auf die gesicherten zurück. Sonst wird nichts verändert." />
                <TextBlock x:Name="RestoreText" Style="{StaticResource P}" Margin="0,6,0,0" Visibility="Collapsed" />

                <!-- 2 -->
                <TextBlock Style="{StaticResource H}" Text="2. Eigene Daten des Soundboards löschen" />
                <TextBlock x:Name="TracesText" Style="{StaticResource P}" />
                <CheckBox x:Name="KeepSounds" Content="Sounds behalten (der Sound-Ordner bleibt)" IsChecked="True" Margin="0,8,0,0" Checked="OnKeepChanged" Unchecked="OnKeepChanged" />
                <Button x:Name="RemoveButton" Style="{StaticResource B}" Content="Eigene Daten löschen …" Click="OnRemoveTraces" />
                <TextBlock x:Name="RemoveText" Style="{StaticResource P}" Margin="0,6,0,0" Visibility="Collapsed" />

                <!-- 3 -->
                <TextBlock Style="{StaticResource H}" Text="3. Virtuelles Kabel entfernen (VB-CABLE)" />
                <TextBlock Style="{StaticResource P}"
                           Text="Das Soundboard entfernt den Treiber nicht selbst – das macht VB-Audios eigenes Setup. So geht es sauber:" />
                <TextBlock Style="{StaticResource P}" Margin="0,6,0,0">
                    <Run Text="1. VBCABLE_Setup_x64.exe (aus dem ZIP von vb-cable.com) mit Rechtsklick → „Als Administrator ausführen“ starten." /><LineBreak />
                    <Run Text="2. „Remove Driver“ klicken." /><LineBreak />
                    <Run Text="3. Windows neu starten." /><LineBreak />
                    <Run Text="4. Geräte-Manager öffnen → Ansicht → „Ausgeblendete Geräte anzeigen“. Unter „Audio, Video und Gamecontroller“ und „Audioeingänge und -ausgänge“ verbliebene VB-Audio-Einträge mit Rechtsklick → „Gerät deinstallieren“ entfernen, Haken bei „Treiber entfernen“ setzen, falls angeboten." /><LineBreak />
                    <Run Text="5. Windows noch einmal neu starten." />
                </TextBlock>
                <TextBlock Style="{StaticResource P}" Margin="0,6,0,0" Foreground="{DynamicResource SubTextBrush}"
                           Text="Für Fortgeschrittene: Ob noch ein VB-Audio-Treiber im Treiberspeicher liegt, zeigt „pnputil /enum-drivers“ in einer Eingabeaufforderung als Administrator; entfernen mit „pnputil /delete-driver oemNN.inf“ (NN aus der Liste). Nur nötig, wenn das Setup Reste lässt." />
                <Button Style="{StaticResource B}" Content="Geräte-Manager öffnen" Click="OnDeviceManager" />

                <!-- 4 -->
                <TextBlock Style="{StaticResource H}" Text="4. Zum Schluss: Discord und Vergleich" />
                <TextBlock x:Name="DiscordText" Style="{StaticResource P}" />
                <TextBlock Style="{StaticResource P}" Margin="0,10,0,0"
                           Text="Nach dem Neustart noch einmal vergleichen. Grün heißt: wie vor dem Soundboard." />
                <Button Style="{StaticResource B}" Content="Neu vergleichen" Click="OnCompare" />
                <DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" MaxHeight="320"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                          HorizontalGridLinesBrush="{DynamicResource GridLine}" Background="{DynamicResource SurfaceBg}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Was" Binding="{Binding What}" Width="2*" />
                        <DataGridTextColumn Header="Gesichert" Binding="{Binding Saved}" Width="2*" />
                        <DataGridTextColumn Header="Jetzt" Binding="{Binding Now}" Width="2*" />
                        <DataGridTemplateColumn Header="Ergebnis" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="K" Text="{Binding KindText}" FontWeight="SemiBold" Foreground="{DynamicResource DiffText}" Margin="4,0" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding KindText}" Value="gleich">
                                            <Setter TargetName="K" Property="Foreground" Value="{DynamicResource OkText}" />
                                            <Setter TargetName="K" Property="FontWeight" Value="Normal" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="CompareText" Style="{StaticResource P}" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
