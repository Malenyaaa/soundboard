<Window x:Class="Soundboard.App.Views.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Soundboard.App.Views"
        Icon="/Assets/Soundboard.ico"
        Width="680" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontText}" FontSize="{DynamicResource SizeText}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="TrimNum" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontDisplay}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <!-- Cut a pad: the wave with two edges, the three times under it, listen / whole sound on the left,
         apply / cancel on the right. Esc cancels. Nothing in here changes size while it is used. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="OnApply" IsDefault="True" />
                    <Button x:Name="CancelButton" MinWidth="96" Margin="8,0,0,0" Click="OnCancel" IsCancel="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- Fixed width: "Listen" and "Stop listening" swap without moving anything. -->
                    <Button x:Name="ListenButton" Width="150" Click="OnListen" />
                    <Button x:Name="WholeButton" MinWidth="110" Margin="8,0,0,0" Click="OnWhole" />
                </StackPanel>
            </DockPanel>
        </Border>
        <StackPanel Margin="20,18,20,18">
            <TextBlock x:Name="HeadingText" FontSize="{DynamicResource SizeGroup}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="HintText" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Margin="0,14,0,0" ClipToBounds="True">
                <views:WaveTrimView x:Name="Wave" Height="150"
                                    Background="{DynamicResource FieldBg}"
                                    WaveBrush="{DynamicResource AccentLine}"
                                    MutedBrush="{DynamicResource SubTextBrush}"
                                    VeilBrush="{DynamicResource PressedOverlay}"
                                    HandleBrush="{DynamicResource TextBrush}" />
            </Border>

            <!-- Times: tabular figures in fixed columns, so they do not jitter while an edge is dragged. -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StartLabel" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StartValue" Grid.Column="1" Style="{StaticResource TrimNum}" />
                <TextBlock x:Name="EndLabel" Grid.Column="2" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="EndValue" Grid.Column="3" Style="{StaticResource TrimNum}" />
                <TextBlock x:Name="LengthLabel" Grid.Column="4" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="LengthValue" Grid.Column="5" Style="{StaticResource TrimNum}" FontWeight="SemiBold" />
            </Grid>

            <!-- "Cannot listen now" says why, right under the buttons' area; hidden otherwise. -->
            <Border x:Name="ListenNote" Visibility="Collapsed" Margin="0,12,0,0" Padding="10,8" CornerRadius="4"
                    Background="{DynamicResource RaisedBg}" BorderBrush="{DynamicResource DiffText}" BorderThickness="1">
                <TextBlock x:Name="ListenNoteText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
