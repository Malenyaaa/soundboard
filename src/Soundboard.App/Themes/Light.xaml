<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light mode: the original colours of the window. -->
    <SolidColorBrush x:Key="WindowBg" Color="#F6F7F9" />
    <SolidColorBrush x:Key="SurfaceBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusBg" Color="#ECEEF2" />
    <SolidColorBrush x:Key="LineBrush" Color="#D5D9E0" />
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#4A5260" />
    <SolidColorBrush x:Key="SignalBrush" Color="#1F5FA8" />
    <SolidColorBrush x:Key="OnSignalBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#1F5FA8" />
    <SolidColorBrush x:Key="HoverOverlay" Color="#14000000" />
    <SolidColorBrush x:Key="PressedOverlay" Color="#2A000000" />
    <SolidColorBrush x:Key="NoticeBg" Color="#FFF4C2" />
    <SolidColorBrush x:Key="NoticeLine" Color="#D9A800" />
    <SolidColorBrush x:Key="NoticeText" Color="#3D2E00" />
    <SolidColorBrush x:Key="StopBg" Color="#B3261E" />
    <SolidColorBrush x:Key="StopHover" Color="#951F18" />
    <SolidColorBrush x:Key="StopPressed" Color="#6E1712" />
    <SolidColorBrush x:Key="StopFocus" Color="#FFD54F" />
    <SolidColorBrush x:Key="OnStopBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TileLine" Color="#C3C9D3" />
    <SolidColorBrush x:Key="TileText" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TileSubText" Color="#3A4250" />
    <SolidColorBrush x:Key="TrackBg" Color="#20000000" />
    <SolidColorBrush x:Key="GridLine" Color="#E3E6EB" />
    <SolidColorBrush x:Key="OkText" Color="#1E6B34" />
    <SolidColorBrush x:Key="DiffText" Color="#8A4B00" />
    <SolidColorBrush x:Key="MeterBrush" Color="#2E7D32" />
</ResourceDictionary>
